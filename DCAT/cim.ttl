<https://data.colorado.gov/d/2e5i-5hfy> a dcat:Dataset ;
    dct:description "Criminal arrests summarized by type of crime for police districts in Colorado from 2001 to 2016 from the Colorado Department of Public Safety (CDPS)."@en ;
    dct:language <http://publications.europa.eu/resource/authority/language/ENG> ;
    dct:title "Crime Arrests by Police District 2001-2016 in Colorado"@en ;
    dcat:distribution <https://data.colorado.gov/resource/2e5i-5hfy.csv> .

<https://data.colorado.gov/d/2h36-cxjh> a dcat:Dataset ;
    dct:description "Aggregated from thousands of local jurisdictions by the Colorado Department of Local Affairs Demography office. Many of the district boundaries were created from scanned drawings or digitized PDFs, and therefore no guarantee of accuracy can be made for the data."@en ;
    dct:language <http://publications.europa.eu/resource/authority/language/ENG> ;
    dct:title "Soil Districts in Colorado"@en ;
    dcat:distribution <https://data.colorado.gov/resource/2h36-cxjh.csv> .

<https://data.colorado.gov/d/2h6w-z9ry> a dcat:Dataset ;
    dct:description "Highway locations and various data: speed limits, surface type, access, etc, from the Colorado Department of Transportation (CDOT)."@en ;
    dct:language <http://publications.europa.eu/resource/authority/language/ENG> ;
    dct:title "Map of Highways in Colorado"@en ;
    dcat:distribution <https://data.colorado.gov/resource/2h6w-z9ry.csv> .

<https://data.colorado.gov/d/2kvt-7ybu> a dcat:Dataset ;
    dct:description "Revenues for Colorado Department of Transportation for the current and previous state fiscal year."@en ;
    dct:language <http://publications.europa.eu/resource/authority/language/ENG> ;
    dct:title "CDOT Revenues"@en ;
    dcat:distribution <https://data.colorado.gov/resource/2kvt-7ybu.csv> .

<https://data.colorado.gov/d/2p2k-iq7f> a dcat:Dataset ;
    dct:description "Average rents and vacancies distributed by age of building structure for regions across Colorado dating back to 2006 as defined by the Colorado Department of Local Affairs Housing Division (DOLA)."@en ;
    dct:language <http://publications.europa.eu/resource/authority/language/ENG> ;
    dct:title "Vacancies by Age of Building for Colorado 2016"@en ;
    dcat:distribution <https://data.colorado.gov/resource/2p2k-iq7f.csv> .

<https://data.colorado.gov/d/2rrq-heiy> a dcat:Dataset ;
