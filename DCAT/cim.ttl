<https://data.colorado.gov/d/23sa-se52> a dcat:Dataset ;
    dct:description "CBP is an annual series that provides subnational economic data by industry. This series includes the number of establishments, employment during the week of March 12, first quarter payroll, and annual payroll."@en ;
    dct:language <http://publications.europa.eu/resource/authority/language/ENG> ;
    dct:title "Colorado Business Patterns 2019 US Census"@en ;
    dcat:distribution <https://data.colorado.gov/resource/23sa-se52.csv> .

<https://data.colorado.gov/d/24hn-nv39> a dcat:Dataset ;
    dct:description "GIS data on locations of fire stations in Denver County in 2019."@en ;
    dct:language <http://publications.europa.eu/resource/authority/language/ENG> ;
    dct:title "Fire Stations in Denver County 2019"@en ;
    dcat:distribution <https://data.colorado.gov/resource/24hn-nv39.csv> .

<https://data.colorado.gov/d/24px-ypnu> a dcat:Dataset ;
    dct:description "This datasets provides annual counts of arrests made by type of crime for over 300 Police Agencies in Colorado, starting in 2008. If you are looking for historical arrest data prior to 2008, please refer to the Annual Arrests in Colorado by Offense (1970–2021) here: https://data.colorado.gov/Demographics/Annual-Arrests-in-Colorado-by-Offense-1970-2022/xi5f-mkzt/about_data"@en ;
    dct:language <http://publications.europa.eu/resource/authority/language/ENG> ;
    dct:title "Annual Arrests in Colorado by Offense (Current Dataset)"@en ;
    dcat:distribution <https://data.colorado.gov/resource/24px-ypnu.csv> .

<https://data.colorado.gov/d/25ry-d5r8> a dcat:Dataset ;
    dct:description "Traffic counts on highways and various calculations, from Colorado Department of Transportation (CDOT), for 2017"@en ;
    dct:language <http://publications.europa.eu/resource/authority/language/ENG> ;
    dct:title "Map of Highway Traffic Counts in Colorado 2017"@en ;
    dcat:distribution <https://data.colorado.gov/resource/25ry-d5r8.csv> .

