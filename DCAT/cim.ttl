<https://data.colorado.gov/d/2cpa-vbur> a dcat:Dataset ;
    dct:description "Income (per capita or total) for each county by year with rank and population. From Colorado Department of Labor and Employment (CDLE), since 1969."@en ;
    dct:language <http://publications.europa.eu/resource/authority/language/ENG> ;
    dct:title "Personal Income in Colorado"@en ;
    dcat:distribution <https://data.colorado.gov/resource/2cpa-vbur.csv> .

