<https://data.colorado.gov/d/2sn7-naei> a dcat:Dataset ;
    dct:description "The Toxics Release Inventory (TRI) contains information on the release and waste management for over 800 toxic chemicals and toxic chemical categories as reported annually by facilities in certain industries as well as federal facilities."@en ;
    dct:language <http://publications.europa.eu/resource/authority/language/ENG> ;
    dct:title "Colorado Toxic Release Inventory 2020"@en ;
    dcat:distribution <https://data.colorado.gov/resource/2sn7-naei.csv> .

<https://data.colorado.gov/d/2tib-gtif> a dcat:Dataset ;
    dct:description "Railroad locations with associated data (in service, types of passenger, etc) from the Colorado Department of Transportation (CDOT)."@en ;
